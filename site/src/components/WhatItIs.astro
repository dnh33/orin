---
const stagesRaw = [
  {
    name: 'orind',
    role: 'resident daemon',
    body: 'Scans every drive once, hidden files included, and holds the result in memory.',
  },
  {
    name: 'index',
    role: 'whole-disk index',
    body: 'Structured entries the CLI filters by name, extension, size, depth, and type.',
  },
  {
    name: 'orin / on',
    role: 'command line',
    body: 'Sends the query over a local pipe and prints matching paths. on is the short alias.',
  },
];

const stages = stagesRaw;
const flow = stages.flatMap((stage, index) =>
  index === 0
    ? [{ kind: 'stage', stage }]
    : [
        { kind: 'arrow' },
        { kind: 'stage', stage },
      ],
);

type Fact = {
  label: string;
  body: string;
  mark?: boolean;
};

const facts: Fact[] = [
  {
    label: 'auto-spawn',
    body: 'The first query starts <code>orind</code> when it is not running, so there is no service to install, start, or supervise.',
  },
  {
    label: 'platforms',
    body: 'Windows only. The daemon, CLI, TUI and MCP server all target it.',
    mark: true,
  },
  {
    label: 'status',
    body: 'orin status --json reports daemon version, indexed entries, memory use, and roots.',
  },
];

---

<section class="section" id="what">
  <div class="wrap">
    <h2 class="h2" data-reveal>The whole disk, held in memory.</h2>
    <p class="lede" data-reveal>
      <code>orind</code> scans the drives once and keeps the index resident, so a query reads
      structured entries instead of walking the tree on every call.
    </p>

    <div class="flow" data-reveal>
      {
        flow.map((item) =>
          item.kind === 'arrow' ? (
            <div class="arrow" aria-hidden="true">
              <svg viewBox="0 0 48 16" width="48" height="16">
                <path d="M0 8h38M32 2l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.4" />
              </svg>
            </div>
          ) : (
            <div class="stage panel">
              <p class="stage-name"><code>{item.stage.name}</code></p>
              <p class="stage-role">{item.stage.role}</p>
              <p class="stage-body">{item.stage.body}</p>
            </div>
          ),
        )
      }
    </div>

    <dl class="facts" data-reveal>
      {
        facts.map((fact) => (
          <div class="fact">
            <dt>{fact.label}</dt>
            <dd>
              {fact.mark && (
                <svg class="win-mini" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
                  <rect x="0" y="0" width="7" height="7" rx="1.5"></rect>
                  <rect x="9" y="0" width="7" height="7" rx="1.5"></rect>
                  <rect x="0" y="9" width="7" height="7" rx="1.5"></rect>
                  <rect x="9" y="9" width="7" height="7" rx="1.5"></rect>
                </svg>
              )}
              <span set:html={fact.body}></span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .flow {
    margin-top: clamp(36px, 5vw, 52px);
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: stretch;
    gap: 14px;
  }

  .stage {
    padding: 20px;
    min-width: 0;
    transition:
      border-color var(--t-fast) ease,
      transform var(--t-fast) var(--ease-out),
      background-color var(--t-fast) ease;
  }

  .stage-name {
    font: 600 17px/1.2 var(--mono);
    letter-spacing: -0.02em;
  }

  /* the stage title is already code type: no chip inside the card */
  .stage-name code {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
  }

  .stage-role {
    margin-top: 6px;
    font: 500 11px/1.4 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .stage-body {
    margin-top: 12px;
    color: var(--dim);
    font-size: 14.5px;
    line-height: 1.55;
  }

  .arrow {
    display: flex;
    align-items: center;
    color: var(--line-2);
  }

  .facts {
    margin: clamp(40px, 5vw, 56px) 0 0;
    border-top: 1px solid var(--line);
  }

  .fact {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 20px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .fact dt {
    font: 500 13px/1.6 var(--mono);
    color: var(--accent);
  }

  .fact dd {
    margin: 0;
    color: var(--dim);
    font-size: 15.5px;
    max-width: 70ch;
  }

  /* platform mark: same four-pane geometry as the Install header, smaller */
  .win-mini {
    fill: var(--accent);
    vertical-align: -2px;
    margin-right: 7px;
  }

  @media (hover: hover) and (pointer: fine) {
    .stage:hover {
      border-color: var(--line-2);
      background: var(--bg-2);
      transform: translateY(-2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage {
      transition: none;
    }

    .stage:hover {
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .flow {
      grid-template-columns: 1fr;
    }

    .arrow {
      transform: rotate(90deg);
      justify-content: center;
      padding-block: 2px;
    }
  }

  @media (max-width: 640px) {
    .fact {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
