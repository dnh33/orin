---
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow" data-reveal>Whole-disk file search</p>
      <h1 data-reveal>orin<span class="caret" aria-hidden="true"></span></h1>
      <p class="truth" data-reveal>
        orind keeps your drives indexed in memory. <code>orin</code> answers from that index
        instead of walking the tree.
      </p>
      <div class="cta" data-reveal>
        <a class="btn btn-primary" href="#install">Install</a>
        <a class="btn btn-ghost" href="https://github.com/dnh33/orin">View source</a>
      </div>
    </div>

    <div class="term panel" data-reveal aria-label="Example commands">
      <div class="term-bar">
        <span>powershell</span>
        <span class="term-tag">orin</span>
      </div>
      <pre class="term-body"><span class="p">PS&gt;</span> orin query ext:rs type:f --limit 50
<span class="note"># paths stream back from the resident index</span>
<span class="p">PS&gt;</span> orin status --json
<span class="note"># version, indexed entries, memory, roots</span>
<span class="p">PS&gt;</span> on query size:&gt;10M
<span class="note"># on is the short alias of orin</span></pre>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(56px, 9vh, 96px) clamp(64px, 9vw, 112px);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  h1 {
    font-size: clamp(64px, 11vw, 132px);
    letter-spacing: -0.045em;
    line-height: 0.94;
    display: inline-flex;
    align-items: baseline;
    gap: clamp(10px, 2vw, 18px);
  }

  .caret {
    width: clamp(14px, 2.6vw, 26px);
    height: clamp(40px, 7vw, 78px);
    background: var(--accent);
    transform: translateY(0.04em);
    animation: blink 1.15s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .truth {
    margin-top: 22px;
    max-width: 46ch;
    color: var(--dim);
    font-size: clamp(17px, 1.8vw, 19px);
    line-height: 1.6;
  }

  .truth code {
    color: var(--text);
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 1px 6px;
    font-size: 0.86em;
  }

  .cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .term {
    overflow: hidden;
    min-width: 0;
  }

  .term-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .term-tag {
    color: var(--accent);
  }

  .term-body {
    margin: 0;
    padding: 18px 20px 20px;
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.85;
    color: var(--text);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .term-body .p {
    color: var(--accent);
    user-select: none;
  }

  .term-body .note {
    color: var(--faint);
  }

  /* entry motion: only when JS is on and motion is allowed */
  :global(.js) [data-reveal] {
    transition-delay: var(--d, 0ms);
  }

  .copy > :nth-child(1) {
    --d: 0ms;
  }
  .copy > :nth-child(2) {
    --d: 70ms;
  }
  .copy > :nth-child(3) {
    --d: 140ms;
  }
  .copy > :nth-child(4) {
    --d: 210ms;
  }
  .term {
    --d: 240ms;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .term {
      order: 3;
    }
  }

  @media (max-width: 640px) {
    .term-body {
      font-size: 12.5px;
      line-height: 1.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }

    :global(.js) [data-reveal] {
      transition-delay: 0ms;
    }
  }
</style>
