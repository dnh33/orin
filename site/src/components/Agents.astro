---
const facts: { label: string; body: string; cmd: string }[] = [
  {
    label: 'json lines',
    body: '<code>orin query --json</code> writes one JSON object per hit with path, name, type, size, mtime, and score, so a parser reads stdout line by line.',
    cmd: 'orin query ext:rs --json',
  },
  {
    label: 'exit codes',
    body: '0 with results, 1 with no match, 2 on error, the ripgrep convention. A script branches on the code instead of parsing prose.',
    cmd: '$LASTEXITCODE',
  },
  {
    label: 'latency',
    body: 'Warm queries measure a p50 of 8-14 ms, against 45 ms for find, 61 ms for fd, and 41-58 ms for ripgrep. Measured on GitHub windows-latest runners over a 25,926-entry corpus, with a 6.5 ms process spawn floor on every query.',
    cmd: 'orin query main.rs',
  },
  {
    label: 'zero setup',
    body: 'The first query starts the resident daemon and waits for the index: 0.85 s from cold scan to ready, 0.85 s warm start from snapshot. No service to install, start, or supervise.',
    cmd: 'orin query README.md',
  },
  {
    label: 'health check',
    body: '<code>orin status --json</code> returns daemon version, state, entry count, memory use, and roots as one JSON document.',
    cmd: 'orin status --json',
  },
  {
    label: 'filters',
    body: 'ext:, size:, depth:, type:, path:, globs, and regex read the same way in one query string, whether the caller is a person or a script.',
    cmd: 'orin query path:src ext:rs --json',
  },
];

const exits = [
  { code: '0', label: 'results printed' },
  { code: '1', label: 'no match' },
  { code: '2', label: 'error' },
];
---

<section class="section" id="agents">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Built for agents</p>
    <h2 class="h2" data-reveal>Six things an agent can rely on.</h2>
    <p class="lede" data-reveal>
      orin is meant to be called by scripts and agents: structured output, exit codes that mean one
      thing, and no daemon to manage.
    </p>

    <div class="grid" data-reveal>
      {
        facts.map((fact) => (
          <article class="fact">
            <p class="fact-label">{fact.label}</p>
            <p class="fact-body" set:html={fact.body}></p>
            <code class="code fact-cmd">{fact.cmd}</code>
          </article>
        ))
      }
    </div>

    <div class="exits" data-reveal>
      <p class="exits-label">Exit codes follow the ripgrep convention</p>
      <div class="chips">
        {
          exits.map((exit) => (
            <span class="chip">
              <b>{exit.code}</b> {exit.label}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    margin-top: clamp(34px, 4.5vw, 48px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
  }

  .fact {
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--bg-1);
    padding: clamp(18px, 2vw, 22px);
    min-width: 0;
    transition:
      border-color var(--t-fast) ease,
      transform var(--t-fast) var(--ease-out),
      background-color var(--t-fast) ease;
  }

  .fact-label {
    font: 500 10.5px/1 var(--mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .fact-body {
    margin-top: 12px;
    color: var(--dim);
    font-size: 15px;
    line-height: 1.6;
  }

  /* body references keep the code chip look (global rule), commands sit on their own line */
  .fact-cmd {
    display: block;
    margin-top: 14px;
    overflow-x: auto;
    color: var(--text);
    background: var(--bg-2);
  }

  .exits {
    margin-top: clamp(26px, 3.5vw, 36px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }

  .exits-label {
    color: var(--faint);
    font-size: 14px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .chip {
    font: 400 13px/1 var(--mono);
    color: var(--dim);
    border: 1px solid var(--line);
    border-radius: var(--pill);
    padding: 8px 14px;
    background: var(--bg-1);
    transition:
      border-color var(--t-fast) ease,
      color var(--t-fast) ease,
      background-color var(--t-fast) ease;
  }

  .chip b {
    color: var(--accent);
    font-weight: 600;
    margin-right: 6px;
  }

  @media (hover: hover) and (pointer: fine) {
    .fact:hover {
      border-color: var(--line-2);
      background: var(--bg-2);
      transform: translateY(-2px);
    }

    .chip:hover {
      border-color: var(--accent-line);
      color: var(--text);
    }
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fact,
    .chip {
      transition: none;
    }

    .fact:hover {
      transform: none;
    }
  }
</style>
