---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Agents from '../components/Agents.astro';
import WhatItIs from '../components/WhatItIs.astro';
import Install from '../components/Install.astro';
import Benchmarks from '../components/Benchmarks.astro';
import QuerySyntax from '../components/QuerySyntax.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Footer from '../components/Footer.astro';

const title = 'orin - whole-disk file search for agents';
const description =
  'orin answers file queries from a resident index: JSON Lines output, exit codes 0/1/2, and a p50 of 7.2 ms in the published run. The orin and on commands query it. For Windows, MIT OR Apache-2.0.';
---

<Base title={title} description={description}>
  <Nav />
  <main id="main">
    <Hero />
    <Agents />
    <WhatItIs />
    <Install />
    <Benchmarks />
    <QuerySyntax />
    <HowItWorks />
  </main>
  <Footer />
</Base>
